[Unit]
Description=KX OPC UA 多炉台采集客户端（-> TDengine）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kxopc
Group=kxopc
WorkingDirectory=/opt/kx_opc_client
ExecStart=/opt/kx_opc_client/kx_opc_client -config /opt/kx_opc_client/config.yaml
Environment=TZ=Asia/Shanghai
Restart=always
RestartSec=10
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
